{
  "name": "web-crawler",
  "version": "1.0.0",
  "description": "Microservices-based web crawler system",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "restart": "pm2 restart ecosystem.config.js",
    "logs": "pm2 logs",
    "status": "pm2 status",
    "pm2:demo": "bash scripts/pm2-demo.sh",
    "demo": "bash scripts/demo.sh",
    "validate": "bash scripts/validate-demo.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:infra": "docker compose -f docker-compose.infra.yml up -d",
    "dev": "NODE_ENV=development npm run docker:up",
    "prod": "NODE_ENV=production npm run docker:up"
  },
  "keywords": [
    "web-crawler",
    "microservices",
    "nodejs",
    "docker",
    "elasticsearch",
    "mongodb",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pm2": "^7.0.3"
  },
  "devDependencies": {
    "dotenv": "^16.0.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
